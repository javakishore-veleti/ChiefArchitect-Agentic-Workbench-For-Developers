{
  "configs-envs-mapping": [
    {"config-name":"nonprod-us","envs":["dev","qa","staging"]},
    {"config-name":"prod-us","envs":["prod"]}
  ],
  "configs": [
    {
      "config-name":"nonprod-us",
      "org":"example-nonprod",
      "site":"datadoghq.com",
      "auth":{"provider":"env","api-key-env":"AKIV_DD_API_KEY","app-key-env":"AKIV_DD_APP_KEY"},
      "services":[{"name":"example-api","aliases":[],"tags":{"team":"example-team"}}],
      "capabilities":{"apm":true,"logs":true,"rum":false,"llm-observability":false}
    },
    {
      "config-name":"prod-us",
      "org":"example-prod",
      "site":"datadoghq.com",
      "auth":{"provider":"secret-ref","ref":"provider://path/to/datadog"},
      "services":[],
      "capabilities":{}
    }
  ]
}
