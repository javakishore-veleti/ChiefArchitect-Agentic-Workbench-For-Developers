{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://example.invalid/azure-config.schema.json",
  "type":"object","additionalProperties":false,
  "required":["configs-envs-mapping","configs"],
  "properties":{
    "$schema":{"type":"string"},
    "configs-envs-mapping":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["config-name","envs"],"properties":{"config-name":{"type":"string","minLength":1},"envs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}}}}},
    "configs":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/config"}}
  },
  "$defs":{
    "resource":{"type":"object","additionalProperties":false,"required":["name","type","id"],"properties":{"name":{"type":"string"},"type":{"type":"string"},"id":{"type":"string"},"region":{"type":"string"},"resource-group":{"type":"string"}}},
    "application":{"type":"object","additionalProperties":false,"required":["name","resource-refs"],"properties":{"name":{"type":"string"},"aliases":{"type":"array","items":{"type":"string"}},"repository":{"type":"string"},"resource-refs":{"type":"array","items":{"$ref":"#/$defs/resource"}}}},
    "program":{"type":"object","additionalProperties":false,"required":["name"],"properties":{"name":{"type":"string"},"applications":{"type":"array","items":{"$ref":"#/$defs/application"}},"resource-refs":{"type":"array","items":{"$ref":"#/$defs/resource"}}}},
    "portfolio":{"type":"object","additionalProperties":false,"required":["name"],"properties":{"name":{"type":"string"},"programs":{"type":"array","items":{"$ref":"#/$defs/program"}},"applications":{"type":"array","items":{"$ref":"#/$defs/application"}},"resource-refs":{"type":"array","items":{"$ref":"#/$defs/resource"}}}},
    "subscription":{"type":"object","additionalProperties":false,"required":["alias","subscription-id"],"properties":{"alias":{"type":"string"},"subscription-id":{"type":"string"},"portfolios":{"type":"array","items":{"$ref":"#/$defs/portfolio"}},"applications":{"type":"array","items":{"$ref":"#/$defs/application"}},"resource-refs":{"type":"array","items":{"$ref":"#/$defs/resource"}}}},
    "tenant":{"type":"object","additionalProperties":false,"required":["alias","tenant-id","subscriptions"],"properties":{"alias":{"type":"string"},"tenant-id":{"type":"string"},"subscriptions":{"type":"array","items":{"$ref":"#/$defs/subscription"}}}},
    "config":{"type":"object","additionalProperties":false,"required":["config-name","tenants"],"properties":{"config-name":{"type":"string"},"tenants":{"type":"array","items":{"$ref":"#/$defs/tenant"}}}}
  }
}
