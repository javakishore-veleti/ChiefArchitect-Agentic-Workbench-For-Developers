{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "type":"object",
  "required":["schema-version","configs-envs-mapping","configs"],
  "properties":{
    "schema-version":{"const":1},
    "external-override-uri":{"type":"string"},
    "configs-envs-mapping":{"type":"array","items":{"type":"object","required":["config-name","envs"],"properties":{"config-name":{"type":"string","minLength":1},"envs":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}}},"additionalProperties":false}},
    "configs":{"type":"array","items":{"type":"object","required":["config-name","deployments"],"properties":{"config-name":{"type":"string","minLength":1},"key-vocabulary":{"type":"string"},"deployments":{"type":"array","minItems":1,"items":{"type":"object","required":["name","provider","endpoint","port","tls","production","secret-ref"],"properties":{"name":{"type":"string"},"provider":{"enum":["oss","enterprise","cloud","azure","aws"]},"endpoint":{"type":"string"},"port":{"type":"integer","minimum":1,"maximum":65535},"tls":{"type":"boolean"},"database":{"type":"integer","minimum":0},"production":{"type":"boolean"},"secret-ref":{"$ref":"#/$defs/secretRef"}},"additionalProperties":false}},"additionalProperties":false}}
  },
  "$defs":{"secretRef":{"type":"object","required":["provider","name"],"properties":{"provider":{"enum":["environment","mounted-file","azure-key-vault","aws-secrets-manager","hashicorp-vault","kubernetes-secret"]},"name":{"type":"string","minLength":1},"vault":{"type":"string"},"key":{"type":"string"}},"additionalProperties":false}},
  "additionalProperties":false
}
